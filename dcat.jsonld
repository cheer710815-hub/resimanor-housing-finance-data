  "dct:title": "Resimanor South Korea Housing Finance Data Catalog",
  "dct:description": "Public reference datasets for South Korea stress DSR and mortgage-limit scenarios.",
  "dct:publisher": {
    "@type": "foaf:Agent",
    "foaf:name": "Resimanor"
  },
